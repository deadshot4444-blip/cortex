# so a POST (the suggestion form) is not turned into a 404; route-meta.js sets
# HTTP 404 on GET/HEAD for paths that are not routes. Do not add /section/ → /section
# 301 rules: Netlify slash-collapses them and the section 301s to itself.
/*  /index.html  200
